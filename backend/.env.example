PORT=8080

# MongoDB — points at the local `mongo` container in dev; an Atlas SRV
# connection string in production, same code either way. `mongo` runs as
# a single-node replica set (transactions require one); it advertises
# itself internally as "mongo:27017", which only resolves from inside
# the docker-compose network. Running this binary on the host instead
# (e.g. `go run ./cmd/api` outside Docker) needs directConnection=true
# so the driver talks to this node directly rather than trying to
# rediscover "mongo:27017" from the host. The same applies to MongoDB
# Compass or mongosh run from the host — see the README.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DATABASE=betailo

# Object storage (listing photos) — an S3-compatible endpoint. Points
# at local SeaweedFS (its S3 gateway) in dev, Cloudflare R2 in
# production; same code, same STORAGE_* variables either way.
STORAGE_ENDPOINT=http://localhost:9000
# Optional — only needed when STORAGE_ENDPOINT isn't reachable from a
# browser (e.g. the docker-compose backend service, whose
# STORAGE_ENDPOINT is the internal "http://seaweedfs:9000"). Presigned
# URLs are handed to the browser, so they're built against this one
# instead. Defaults to STORAGE_ENDPOINT, which is correct here.
STORAGE_PUBLIC_ENDPOINT=
STORAGE_BUCKET=betailo
STORAGE_ACCESS_KEY=betailo
STORAGE_SECRET_KEY=betailo123
STORAGE_REGION=us-east-1

# Auth — HMAC-SHA256 JWT signing. No default: an empty or predictable
# secret would let anyone forge a valid token, so startup fails without
# one. Generate a real one with `openssl rand -base64 32`.
JWT_SECRET=change-me-to-a-long-random-value
# Access token lifetime, as a Go duration string. Optional — falls back
# to 24h if unset or unparsable.
ACCESS_TOKEN_TTL=24h
# Refresh token lifetime (see docs/adr/0008), as a Go duration string.
# Optional — falls back to 30 days if unset or unparsable.
REFRESH_TOKEN_TTL=720h

# CORS — the browser origins allowed to call this API (the Angular
# app), comma-separated: add the machine's LAN address
# (http://192.168.x.x:4200) to try the app from a phone. Optional — falls back to http://localhost:4200 if unset. In
# production: the Vercel address, scheme included, no trailing slash
# (https://betailo.vercel.app). Exact origins only: "*" cannot work,
# browsers refuse it on requests that carry the session cookie.
CORS_ALLOWED_ORIGIN=http://localhost:4200

# The refresh-token cookie's attributes (see docs/adr/0008).
# COOKIE_SECURE: optional, defaults to true — only set to false for a
# plain-http local setup that isn't localhost (localhost itself works
# fine with Secure=true in every modern browser).
COOKIE_SECURE=true
# COOKIE_SAMESITE: "none" | "lax" | "strict". Optional, defaults to
# "none" — correct today because the frontend and backend are on
# different origins in production (no nginx /api proxy is actually
# wired up yet, despite the architecture doc's diagram). Switch to
# "lax" only once that's no longer true.
COOKIE_SAMESITE=none
# TRUST_PROXY_HEADERS: "true" keys auth rate limiting on the first
# X-Forwarded-For hop instead of the TCP peer. Set it only behind a
# proxy that overwrites that header (Render does). Otherwise a client
# could pick its own key and dodge the limit. Defaults to false.
TRUST_PROXY_HEADERS=false

# Selling. Every account is personal and can open farms; a farm sells
# once staff approved the proof its owner submitted.
# MAX_FARMS_PER_ACCOUNT: how many farms one account may own (1 when
# unset). Staff can raise it for a single account from the back office.
MAX_FARMS_PER_ACCOUNT=1
# FARM_AUTO_APPROVE: test switch. "true" approves a farm as soon as its
# owner submits it, proof or not, so the selling flow can be tried
# online without a staff member. Such farms are marked auto-approved
# and show no "verified" badge. Leave "false" with real sellers.
FARM_AUTO_APPROVE=false

# Back office, day zero. Nobody can register into the staff and only a
# super admin grants a staff role, so the first one comes from here: at
# every startup the account with this email is made the ROOT account,
# or created with this password (8+ characters) if it doesn't exist.
#   - The root is a super admin the API can never demote or suspend.
#   - An account that already exists keeps its own password: this one
#     is only used at creation, so changing it later resets nothing.
#   - There is one root: point the email at another account and the
#     mark moves; the former root stays an ordinary super admin.
#   - Other staff (moderator, finance, support, super admin) are added
#     from the back office, "Équipe & rôles", by the root.
# Left empty, the API starts and logs an error while no super admin exists.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- Staff sign-in ---
# STAFF_MFA_REQUIRED: staff must pass a second factor to use the back
# office: an authenticator app (TOTP) or a passkey. On unless set to
# "false". A staff member without one is sent to set it up at sign-in;
# an invited member does it right after accepting. Turn it off only on a
# development machine or for automated tests.
STAFF_MFA_REQUIRED=true
# SUPER_ADMIN_RESET_MFA: the root account's way back in when its
# authenticator and passkeys are lost. Set to "true" and restart: the
# root's second factors are removed (logged as an error at startup).
# Sign in, set one up again, then remove the variable and restart.
# SUPER_ADMIN_RESET_MFA=true

# --- Public address and e-mail ---
# APP_PUBLIC_URL: where the site's pages are served. Links in e-mails
# point there, and passkeys are bound to its host: changing the host
# later makes existing passkeys unusable. Defaults to the first
# CORS_ALLOWED_ORIGIN.
APP_PUBLIC_URL=http://localhost:4200
# SMTP account used for staff invitations, password resets and the
# decisions on a farm. The server's STARTTLS is used when offered.
# Without SMTP_HOST nothing is sent: each message is written to the log.
# SMTP_PORT: Render's free instances block outgoing ports 25, 465 and
# 587, so use a provider that also listens on 2525 (Brevo:
# smtp-relay.brevo.com). 2525 works on paid instances too.
# Local development: docker-compose sends to Mailpit (localhost:8025).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender, as an address or "Name <address>". The address must be one
# the SMTP provider has verified for your account.
MAIL_FROM=Betailo <no-reply@example.com>

# --- Deploying (Render + Vercel) ---
# What to set where, step by step: README, section "Déploiement".
# The frontend takes a single setting, on Vercel: API_BASE_URL, the
# address of this API (https://<service>.onrender.com).
