PORT=8080

# MongoDB — points at the local `mongo` container in dev; an Atlas SRV
# connection string in production, same code either way. `mongo` runs as
# a single-node replica set (transactions require one); it advertises
# itself internally as "mongo:27017", which only resolves from inside
# the docker-compose network. Running this binary on the host instead
# (e.g. `go run ./cmd/api` outside Docker) needs directConnection=true
# so the driver talks to this node directly rather than trying to
# rediscover "mongo:27017" from the host. The same applies to MongoDB
# Compass or mongosh run from the host — see the README.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DATABASE=betailo

# Object storage (listing photos) — an S3-compatible endpoint. Points
# at local SeaweedFS (its S3 gateway) in dev, Cloudflare R2 in
# production; same code, same STORAGE_* variables either way.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=betailo
STORAGE_ACCESS_KEY=betailo
STORAGE_SECRET_KEY=betailo123
STORAGE_REGION=us-east-1
